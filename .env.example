# Copy to .env and adjust. Pandaro needs no secrets: these only control where it is served.

# Host port the container is published on.
PANDARO_PORT=8080

# Interface to bind. Use 127.0.0.1 when a reverse proxy on the same host terminates HTTPS.
PANDARO_BIND=0.0.0.0

# Sub-path when serving under a prefix, e.g. /pandaro/ (must start and end with a slash).
PANDARO_BASE=/
